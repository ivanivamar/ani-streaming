{
  "name": "ani-stream",
  "version": "0.0.0",
  "private": true,
  "description": "Private anime streaming app: Angular 22 PWA + Firestore catalogue + Google Drive episodes.",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "ng": "ng",
    "start": "node scripts/build-jassub.mjs && ng serve",
    "build": "node scripts/build-jassub.mjs && ng build && node scripts/build-sw.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "functions:test": "npm --prefix firebase/functions test",
    "functions:bundle": "npm --prefix firebase/functions run bundle",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "test:rules": "npm run test -w @ani/rules-tests"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "firebase": "^13.2.0",
    "jassub": "2.5.23",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.0",
    "esbuild": "0.28.2",
    "eslint-plugin-boundaries": "^7.4.1",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  }
}
