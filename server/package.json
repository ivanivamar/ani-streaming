{
  "name": "ani-stream-server",
  "version": "0.0.0",
  "private": true,
  "description": "Node backend for ani.stream — allanime scraping + Firestore-backed user data, guarded by Firebase Auth (README.md \"Backend contract\").",
  "type": "module",
  "engines": {
    "node": ">=20"
