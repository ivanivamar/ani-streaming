/* Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@catalog/*": ["./src/app/contexts/catalog/*"],
      "@playback/*": ["./src/app/contexts/playback/*"],
      "@library/*": ["./src/app/contexts/library/*"],
      "@releases/*": ["./src/app/contexts/releases/*"],
      "@identity/*": ["./src/app/contexts/identity/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@shell/*": ["./src/app/shell/*"],
      "@ani/contracts": ["./packages/contracts/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.spec.json" }]
}
